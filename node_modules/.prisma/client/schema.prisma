// RaisoVoice - Prisma Schema with SQL Database (SQLite)
// Built with pure HTML, CSS, JavaScript, Prisma, and SQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Complaint {
  id              String   @id
  trackingCode    String
  category        String
  subject         String
  description     String
  location        String?
  priority        String   @default("Medium")
  isAnonymous     Boolean  @default(true)
  studentName     String?
  studentRegNo    String?
  studentEmail    String?
  status          String   @default("Filed")
  department      String   @default("Unassigned")
  assignedOfficer String   @default("Pending Assignment")
  slaHours        Int      @default(72)
  slaDeadline     DateTime
  isEscalated     Boolean  @default(false)
  attachmentName  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  auditChain AuditBlock[]

  @@index([trackingCode])
  @@index([status])
  @@index([category])
  @@index([department])
}

model AuditBlock {
  id           String    @id @default(cuid())
  complaintId  String
  complaint    Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  blockIndex   Int
  previousHash String
  blockHash    String
  action       String
  actor        String
  role         String
  status       String
  notes        String
  department   String
  timestamp    DateTime  @default(now())

  @@index([complaintId, blockIndex])
}

model AdminAuthority {
  id           String   @id
  email        String   @unique
  name         String
  role         String
  department   String
  passwordHash String
  salt         String
  createdAt    DateTime @default(now())

  sessions AdminSession[]
}

model AdminSession {
  id        String         @id @default(cuid())
  token     String         @unique
  adminId   String
  admin     AdminAuthority @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime       @default(now())

  @@index([token])
}
